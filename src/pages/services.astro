---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/widgets/Content.astro";
import Content2 from "@/components/widgets/Content2.astro";
import spotifyImg from "@/assets/images/projects/spotify-dashboard.png";
import chronicImg from "@/assets/images/projects/chronic-disease-risk-analysis.png";
import amazonImg from "@/assets/images/projects/amazon-price-prediction.png";
import reneryImg from "@/assets/images/projects/renery-dashboard.png";

const metadata = {
  title: "Projects",
  description:
    "Selected data analytics and machine learning projects by Milad Nooraei.",
};
---

<BaseLayout {metadata}>
  <Content
    tagline="Portfolio"
    title="Projects"
    description={`<strong>From ideas to real-world solutions.</strong> Here's a collection of projects where I've explored data, built models, and turned complex problems into practical solutions. Each project has taught me something new, challenged the way I think, and given me the opportunity to put my skills into practice.`}
    subtitleClass="text-base leading-7 text-muted-foreground md:text-lg md:leading-8"
    classes={{ container: "max-w-[750px]" }}
  />

  <!-- Renery -->
  <Content2
    items={[
      {
        title: "Problem",
        description:
          "Renewable-energy availability and electricity prices change throughout the day, but households often lack a simple way to compare this information and decide when to use electricity.",
      },
      {
        title: "Tools",
        description:
          "Python, Pandas, Scikit-learn, PostgreSQL, React, Tailwind CSS, Node.js, Express.js, AEMO Energy Data, AER Electricity Plan Data.",
      },
      {
        title: "Outcome",
        description:
          "Built a data pipeline to collect, clean, and manage Australian energy data. Worked with the team to develop renewable-energy forecasts, smart appliance scheduling, and environmental impact tracking.",
      },
    ]}
    image={reneryImg}
    imageAlt="Renery smart energy planner dashboard"
  >
    <Fragment>
      <h3 class="text-2xl font-bold mb-2">Renery — Smart Energy Planner</h3>

      <p class="mb-2 font-medium text-blue-500">Currently in Development</p>
      <p class="mb-4 text-sm text-muted-foreground">
        Master's Capstone Project | Monash University
      </p>

      <p>
        Renery is a web application developed as part of my Master's capstone
        project at Monash University. It helps Australian households find
        greener and more cost-effective times to use electricity by combining
        renewable-energy forecasts, electricity tariffs, and personal schedules.
      </p>
      <p class="mt-4">
        The application supports activities such as washing, dishwashing,
        clothes drying, and EV charging.
      </p>

      <div class="mt-4">
        <a
          href="https://renery.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-blue-500 hover:text-blue-400 transition duration-300 underline underline-offset-4 decoration-blue-500 hover:decoration-blue-300 hover:scale-105 inline-block"
        >
          View Live Website
        </a>
        <p class="mt-2 text-sm text-muted-foreground">
          Currently in development — use password: test
        </p>
      </div>
    </Fragment>
  </Content2>

  <!-- Spotify -->
  <Content2
    isReversed={true}
    items={[
      {
        title: "Problem",
        description:
          "Understand patterns in music data and identify factors influencing song popularity and user listening behaviour.",
      },
      {
        title: "Tools",
        description:
          "Python, SQL, Pandas, Machine Learning (Regression, Clustering, Classification), Power BI.",
      },
      {
        title: "Outcome",
        description:
          "Developed an end-to-end analytics pipeline and interactive dashboards to generate insights and support data-driven recommendations.",
      },
    ]}
    image={spotifyImg}
    imageAlt="Spotify analytics dashboard"
  >
    <Fragment>
      <h3 class="text-2xl font-bold mb-2">Spotify Data Analytics</h3>
      Built a comprehensive data analysis pipeline covering data collection, cleaning,
      database design, statistical analysis, and machine learning. The project explored
      audio features and user behaviour patterns across multiple countries and time
      periods, enabling insight generation and visualization.
      <div class="mt-4">
        <a
          href="https://github.com/MiladNooraei/Spotify-Analytics"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-blue-500 hover:text-blue-400 transition duration-300 underline underline-offset-4 decoration-blue-500 hover:decoration-blue-300 hover:scale-105 inline-block"
        >
          View on GitHub
        </a>
      </div>
    </Fragment>
  </Content2>

  <!-- Chronic Disease -->
  <Content2
    items={[
      {
        title: "Problem",
        description:
          "Analyze how demographic and lifestyle factors influence chronic disease risk and identify meaningful patterns across patient populations.",
      },
      {
        title: "Tools",
        description:
          "R, tidyverse, ggplot2, caret, recipes, logistic regression, multinomial logistic regression.",
      },
      {
        title: "Outcome",
        description:
          "Combined exploratory healthcare analytics with predictive modeling to identify disease-related patterns and support data-driven interpretation.",
      },
    ]}
    image={chronicImg}
    imageAlt="Chronic disease risk analysis charts"
  >
    <Fragment>
      <h3 class="text-2xl font-bold mb-2">
        Chronic Disease Prediction & Progression Analysis
      </h3>
      Analyzed anonymized patient health data to study chronic disease risk and progression
      using both exploratory analysis and predictive modeling. The project examined
      how variables such as smoking, diet quality, gender, biomarkers, and lifestyle
      factors relate to disease outcomes, while also building interpretable classification
      models for chronic disease prediction.
      <div class="mt-4">
        <a
          href="https://github.com/MiladNooraei/Chronic-Disease-Prediction-Progression-Analysis"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-blue-500 hover:text-blue-400 transition duration-300 underline underline-offset-4 decoration-blue-500 hover:decoration-blue-300 hover:scale-105 inline-block"
        >
          View on GitHub
        </a>
      </div>
    </Fragment>
  </Content2>

  <!-- Amazon -->
  <Content2
    isReversed={true}
    items={[
      {
        title: "Problem",
        description:
          "Analyze laptop pricing and specifications to understand market trends and key pricing factors.",
      },
      {
        title: "Tools",
        description:
          "Python, Selenium, BeautifulSoup, Pandas, Linear Regression, Random Forest.",
      },
      {
        title: "Outcome",
        description:
          "Built predictive models to estimate laptop prices and evaluate how technical specifications affect pricing.",
      },
    ]}
    image={amazonImg}
    imageAlt="Amazon laptop price prediction plot"
  >
    <Fragment>
      <h3 class="text-2xl font-bold mb-2">Amazon Laptop Data Analysis</h3>
      Collected real-world product data through web scraping, performed data cleaning
      and feature engineering, and developed machine learning models to predict laptop
      prices and analyze feature importance across different product categories.
      <div class="mt-4">
        <a
          href="https://github.com/MiladNooraei/Amazon-Laptop-Analysis"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-blue-500 hover:text-blue-400 transition duration-300 underline underline-offset-4 decoration-blue-500 hover:decoration-blue-300 hover:scale-105 inline-block"
        >
          View on GitHub
        </a>
      </div>
    </Fragment>
  </Content2>
</BaseLayout>
